# IPCA Implementation

class IPCA:
    """
    Instrumented Principal Components Analysis (IPCA)
    Following Kelly, Pruitt, and Su (2019)
    """
    def __init__(self, n_factors=3, max_iter=100, tol=1e-4):
        self.n_factors = n_factors
        self.max_iter = max_iter
        self.tol = tol
        self.Gamma = None
        self.factors = None
        self.char_cols = None

    def fit(self, returns_df, characteristics_df, char_cols):
        """
        Fit IPCA model

        Parameters:
        -----------
        returns_df : DataFrame with columns ['permno', 'date', 'ret']
        characteristics_df : DataFrame with columns ['permno', 'date'] + char_cols
        char_cols : list of characteristic column names
        """
        # Merge returns and characteristics
        data = returns_df[['permno', 'date', 'ret']].merge(
            characteristics_df[['permno', 'date'] + char_cols],
            on=['permno', 'date'],
            how='inner'
        )

        # Drop rows with missing values
        data = data.dropna()

        # Get unique dates and sort
        dates = sorted(data['date'].unique())

        # Standardize characteristics within each time period
        print("  Standardizing characteristics...")
        scaler = StandardScaler()
        for date in dates:
            mask = data['date'] == date
            if mask.sum() > 1:
                data.loc[mask, char_cols] = scaler.fit_transform(data.loc[mask, char_cols])

        # Initialize
        T = len(dates)
        L = len(char_cols)
        K = self.n_factors

        print(f"\n  IPCA Estimation:")
        print(f"    Time periods (T): {T}")
        print(f"    Characteristics (L): {L}")
        print(f"    Factors (K): {K}")
        print(f"    Total observations: {len(data):,}")

        # Initialize Gamma (L x K matrix)
        np.random.seed(42)
        Gamma = np.random.randn(L, K) * 0.01

        # Initialize factors (T x K matrix)
        factors = np.zeros((T, K))

        # Alternating least squares
        print("\n  Running alternating least squares...")
        for iteration in range(self.max_iter):
            Gamma_old = Gamma.copy()

            # Step 1: Update factors given Gamma
            for t, date in enumerate(dates):
                data_t = data[data['date'] == date].copy()

                if len(data_t) < 10:
                    continue

                Z_t = data_t[char_cols].values
                r_t = data_t['ret'].values
                beta_t = Z_t @ Gamma

                try:
                    factors[t, :] = np.linalg.solve(
                        beta_t.T @ beta_t + 1e-6 * np.eye(K),
                        beta_t.T @ r_t
                    )
                except np.linalg.LinAlgError:
                    factors[t, :] = 0

            # Step 2: Update Gamma given factors
            Z_list = []
            r_list = []
            f_list = []

            for t, date in enumerate(dates):
                data_t = data[data['date'] == date].copy()

                if len(data_t) < 10:
                    continue

                Z_t = data_t[char_cols].values
                r_t = data_t['ret'].values

                for i in range(len(data_t)):
                    Z_list.append(Z_t[i, :])
                    r_list.append(r_t[i])
                    f_list.append(factors[t, :])

            Z_all = np.array(Z_list)
            r_all = np.array(r_list)
            f_all = np.array(f_list)

            # Update Gamma
            Gamma_new = np.zeros((L, K))

            for k in range(K):
                X_k = Z_all * f_all[:, k].reshape(-1, 1)
                try:
                    Gamma_new[:, k] = np.linalg.solve(
                        X_k.T @ X_k + 1e-6 * np.eye(L),
                        X_k.T @ r_all
                    )
                except np.linalg.LinAlgError:
                    Gamma_new[:, k] = Gamma[:, k]

            Gamma = Gamma_new

            # Check convergence
            change = np.linalg.norm(Gamma - Gamma_old) / (np.linalg.norm(Gamma_old) + 1e-10)

            if iteration % 10 == 0:
                print(f"    Iteration {iteration}: change = {change:.6f}")

            if change < self.tol:
                print(f"  ✓ Converged after {iteration + 1} iterations")
                break

        # Normalize factors
        for k in range(K):
            factor_std = np.std(factors[:, k])
            if factor_std > 1e-6:
                factors[:, k] = factors[:, k] / factor_std
                Gamma[:, k] = Gamma[:, k] * factor_std

        # Store results
        self.Gamma = Gamma
        self.factors = pd.DataFrame(
            factors,
            index=dates,
            columns=[f'Factor_{i+1}' for i in range(K)]
        )
        self.char_cols = char_cols
        self.data = data
        self.dates = dates

        return self

    def calculate_metrics(self):
        """Calculate Total R², Relative Pricing Error, and Spread Portfolio Sharpe Ratio"""
        print("\n  Calculating performance metrics...")

        data = self.data
        dates = self.dates

        # Calculate fitted returns
        fitted_returns = []
        actual_returns = []

        for t, date in enumerate(dates):
            data_t = data[data['date'] == date].copy()

            if len(data_t) < 10:
                continue

            Z_t = data_t[self.char_cols].values
            r_t = data_t['ret'].values
            f_t = self.factors.loc[date].values

            beta_t = Z_t @ self.Gamma
            r_fitted = beta_t @ f_t

            fitted_returns.extend(r_fitted)
            actual_returns.extend(r_t)

        fitted_returns = np.array(fitted_returns)
        actual_returns = np.array(actual_returns)

        # 1. Total R²
        ss_res = np.sum((actual_returns - fitted_returns)**2)
        ss_tot = np.sum(actual_returns**2)
        total_r2 = 1 - (ss_res / ss_tot)

        # 2. Relative Pricing Error
        alphas = {}
        mean_returns = {}

        for permno in data['permno'].unique():
            stock_data = data[data['permno'] == permno].copy()

            r_actual_list = []
            r_fitted_list = []

            for _, row in stock_data.iterrows():
                date = row['date']
                if date in self.factors.index:
                    Z_i = row[self.char_cols].values
                    f_t = self.factors.loc[date].values
                    beta_i = Z_i @ self.Gamma

                    r_actual_list.append(row['ret'])
                    r_fitted_list.append(beta_i @ f_t)

            if len(r_actual_list) > 0:
                mean_returns[permno] = np.mean(r_actual_list)
                alphas[permno] = np.mean(r_actual_list) - np.mean(r_fitted_list)

        alpha_array = np.array(list(alphas.values()))
        mean_ret_array = np.array(list(mean_returns.values()))

        relative_pricing_error = np.sqrt(np.mean(alpha_array**2)) / np.sqrt(np.mean(mean_ret_array**2))

        # 3. Spread Portfolio Sharpe Ratio
        spread_returns = []

        for t, date in enumerate(dates):
            data_t = data[data['date'] == date].copy()

            if len(data_t) < 50:
                continue

            Z_t = data_t[self.char_cols].values
            f_mean = self.factors.mean().values
            beta_t = Z_t @ self.Gamma
            exp_ret_t = beta_t @ f_mean

            data_t['exp_ret'] = exp_ret_t

            try:
                data_t['quintile'] = pd.qcut(data_t['exp_ret'], 5, labels=False, duplicates='drop')
            except ValueError:
                continue

            q5_ret = data_t[data_t['quintile'] == 4]['ret'].mean()
            q1_ret = data_t[data_t['quintile'] == 0]['ret'].mean()

            if not (np.isnan(q5_ret) or np.isnan(q1_ret)):
                spread_returns.append(q5_ret - q1_ret)

        spread_returns = np.array(spread_returns)
        sharpe_ratio = np.mean(spread_returns) / np.std(spread_returns) * np.sqrt(12)

        return {
            'total_r2': total_r2,
            'relative_pricing_error': relative_pricing_error,
            'sharpe_ratio': sharpe_ratio
        }

