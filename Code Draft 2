factor_corr = np.zeros((3, 3))
for i in range(3):
    for j in range(3):
        common_dates = ipca_small.factors.index.intersection(ipca_large.factors.index)
        small_factor = ipca_small.factors.loc[common_dates, f'Factor_{i+1}']
        large_factor = ipca_large.factors.loc[common_dates, f'Factor_{j+1}']
        factor_corr[i, j] = np.corrcoef(small_factor, large_factor)[0, 1]

sns.heatmap(factor_corr, annot=True, fmt='.3f', cmap='RdBu_r', center=0,
            xticklabels=[f'Large F{i+1}' for i in range(3)],
            yticklabels=[f'Small F{i+1}' for i in range(3)],
            ax=axes[1, 0], vmin=-1, vmax=1)
axes[1, 0].set_title('Factor Correlations: Small vs Large Cap', fontsize=12, fontweight='bold')

