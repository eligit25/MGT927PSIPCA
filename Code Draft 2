axes[1, 1].plot(ipca_full.factors.index, (1 + ipca_full.factors['Factor_1']).cumprod(),
                label='Full', linewidth=2)
axes[1, 1].plot(ipca_small.factors.index, (1 + ipca_small.factors['Factor_1']).cumprod(),
                label='Small', alpha=0.7)
